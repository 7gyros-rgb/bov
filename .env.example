# Password you'll type into /admin. Set this in Vercel → Settings → Environment Variables.
ADMIN_PASSWORD=changeme

# These are added automatically when you connect a Redis store from the
# Vercel Marketplace (Storage tab → Upstash → Redis). You don't need to
# set them by hand — just connect it and redeploy.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN — either works)
